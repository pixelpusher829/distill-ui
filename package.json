{
	"name": "distill-ui-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"engines": {
		"bun": ">=1.4"
	},
	"scripts": {
		"dev": "bun --filter @distill-ui/docs dev",
		"build": "bun --filter @distill-ui/svelte build && bun --filter @distill-ui/docs build",
		"check": "bun --filter '@distill-ui/*' check",
		"test": "bun --filter @distill-ui/docs test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"reference": "git clone --depth 1 https://github.com/huntabyte/shadcn-svelte.git reference/shadcn-svelte"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"typescript-eslint": "^8.60.1"
	}
}
